# GENERAL
# AZURE_APP_CONFIGURATION_ENDPOINT=https://jnj-sbox-app-acfg-noeu-01.azconfig.io # Uncomment this if you need to connect to azure to retrieve App Config values / Secrets
EXT_INGRESS_HOST=sbox-euw1.nprd.polyphonic.jnjmedtech.com
EXT_JNJ_AUTH_SILENTMODE=true
EXT_JNJ_PORT=8080
EXT_JNJ_HOST=localhost
EXT_JNJ_BASEPATH=jnj-robotic-case-input-svc
EXT_JNJ_ENVIRONMENT=localhost
EXT_JNJ_ENVIRONMENT_NAME=
 
# HEALTH
 
## DISK
EXT_JNJ_HEALTH_DISK_STORAGEPATH=/
EXT_JNJ_HEALTH_DISK_THRESHOLDPERCENTAGE=0.85
 
## MEMORY
EXT_JNJ_HEALTH_MEMORY_THRESHOLDMEBIBYTES=150
EXT_JNJ_HEALTH_MEMORY_BYTESPERKIBIBYTE=1024
EXT_JNJ_HEALTH_MEMORY_KIBIBYTEPERMEBIBYTE=1024
 
## ENABLED CHECKS
EXT_JNJ_HEALTH_ENABLEDCHECKS=memoryHeapHealth
 
# API DOCS
EXT_JNJ_SWAGGER_STATE=true
EXT_JNJ_SWAGGER_OPTION=
 
# REDIS
# EXT_JNJ_FEATURE_CACHE_ENABLED=true
# EXT_JNJ_FEATURE_CACHE_PORT=6380
 
# RETRY MECHANISM
EXT_JNJ_RETRYMECHANISM_DELAYMS=1000
EXT_JNJ_RETRYMECHANISM_TIMESINT=3
 
# API CLIENTS
 
## TenantMgmtClient (TMS - for deriving tenant from DSP user ID)
EXT_JNJ_APICLIENTS_TENANTMGMT_LOGGING_ENABLEREQUESTLOGGING=false
EXT_JNJ_APICLIENTS_TENANTMGMT_LOGGING_ENABLERESPONSELOGGING=false
EXT_JNJ_APICLIENTS_TENANTMGMT_LOGGING_ENABLEERRORLOGGING=false
EXT_JNJ_APICLIENTS_TENANTMGMT_LOGGING_LOGLEVEL=log
EXT_JNJ_APICLIENTS_TENANTMGMT_LOGGING_CONTEXTNAME=tenantMgmtApiClient
 
## NotificationsClient (for handling case created events)
EXT_JNJ_APICLIENTS_NOTIFICATIONS_LOGGING_ENABLEREQUESTLOGGING=false
EXT_JNJ_APICLIENTS_NOTIFICATIONS_LOGGING_ENABLERESPONSELOGGING=false
EXT_JNJ_APICLIENTS_NOTIFICATIONS_LOGGING_ENABLEERRORLOGGING=false
EXT_JNJ_APICLIENTS_NOTIFICATIONS_LOGGING_LOGLEVEL=log
EXT_JNJ_APICLIENTS_NOTIFICATIONS_LOGGING_CONTEXTNAME=notificationsApiClient
 
## MediaMgmtClient (for holding area videos and file uploads)
EXT_JNJ_APICLIENTS_MEDIAMGMT_LOGGING_ENABLEREQUESTLOGGING=false
EXT_JNJ_APICLIENTS_MEDIAMGMT_LOGGING_ENABLERESPONSELOGGING=false
EXT_JNJ_APICLIENTS_MEDIAMGMT_LOGGING_ENABLEERRORLOGGING=false
EXT_JNJ_APICLIENTS_MEDIAMGMT_LOGGING_LOGLEVEL=log
EXT_JNJ_APICLIENTS_MEDIAMGMT_LOGGING_CONTEXTNAME=mediaMgmtApiClient
 
## CaseMgmtClient (for creating surgical cases)
EXT_JNJ_APICLIENTS_CASEMGMT_LOGGING_ENABLEREQUESTLOGGING=false
EXT_JNJ_APICLIENTS_CASEMGMT_LOGGING_ENABLERESPONSELOGGING=false
EXT_JNJ_APICLIENTS_CASEMGMT_LOGGING_ENABLEERRORLOGGING=false
EXT_JNJ_APICLIENTS_CASEMGMT_LOGGING_LOGLEVEL=log
EXT_JNJ_APICLIENTS_CASEMGMT_LOGGING_CONTEXTNAME=caseMgmtApiClient
 
## PDPClient (Polyphonic Data Platform - for querying case/media data)
EXT_JNJ_APICLIENTS_PDP_LOGGING_ENABLEREQUESTLOGGING=false
EXT_JNJ_APICLIENTS_PDP_LOGGING_ENABLERESPONSELOGGING=false
EXT_JNJ_APICLIENTS_PDP_LOGGING_ENABLEERRORLOGGING=false
EXT_JNJ_APICLIENTS_PDP_LOGGING_LOGLEVEL=log
EXT_JNJ_APICLIENTS_PDP_LOGGING_CONTEXTNAME=pdpApiClient
 
## MasterDataClient (for querying procedures)
EXT_JNJ_APICLIENTS_MASTERDATA_LOGGING_ENABLEREQUESTLOGGING=false
EXT_JNJ_APICLIENTS_MASTERDATA_LOGGING_ENABLERESPONSELOGGING=false
EXT_JNJ_APICLIENTS_MASTERDATA_LOGGING_ENABLEERRORLOGGING=false
EXT_JNJ_APICLIENTS_MASTERDATA_LOGGING_LOGLEVEL=log
EXT_JNJ_APICLIENTS_MASTERDATA_LOGGING_CONTEXTNAME=masterDataApiClient
 
# Kafka
EXT_JNJ_KAFKA_CONSUMER_GROUP_ID=robotic-case-input-group
EXT_JNJ_KAFKA_CONSUMER_SESSIONTIMEOUT=30000
EXT_JNJ_KAFKA_CASEINGESTIONTOPIC=case-ingestion-events
 
# Audit
EXT_JNJ_AUDIT_BINDINGNAME=audit-channel
EXT_JNJ_AUDIT_CLUSTERNAME=jnj-sbox-evhns-noeu-01
EXT_JNJ_AUDIT_PERMISSIONS=read,write,security
EXT_JNJ_AUDIT_BROKERS=127.0.0.1:9092
 
# State Change Propagation (for sending POLYPHONIC_CASE_CREATED events to PDP)
EXT_JNJ_STATECHANGE_BINDINGNAME=robotic-case-input
EXT_JNJ_STATECHANGE_CLUSTERNAME=jnj-plnc-sbox-evhns-noeu-01
EXT_JNJ_STATECHANGE_PERMISSIONS=read,write,security
EXT_JNJ_STATECHANGE_BROKERS=127.0.0.1:9092
 
AUDIT_BROKERS=127.0.0.1:9092
STATE_CHANGE_BROKERS=127.0.0.1:9092
 
# JNJ Private Admin Operations
EXT_JNJ_ADMIN_OPERATIONS_ROLES=JnJ-Case-Admin
EXT_JNJ_ADMIN_ALLTENANTSACCESS_ROLES=JnJ-Case-Admin
 
# CORS
EXT_JNJ_SECURITY_CORS_ORIGIN=true
EXT_JNJ_SECURITY_CORS_METHODS=GET,POST,PUT,PATCH,DELETE
EXT_JNJ_SECURITY_CORS_ALLOWEDHEADERS=Authorization,X-Authorization,Content-Type
EXT_JNJ_SECURITY_CORS_MAXAGE=3600
 
# Security
EXT_JNJ_SECURITY_RBAC_ENABLED=true
EXT_JNJ_SECURITY_RBAC_SCOPES_DEFAULT=polyphonic
 
# WEB CLIENT (for service-to-service authentication)
EXT_JNJ_WEBCLIENT_SCOPE=nucleus create read update admin robotic-case-input-svc:create:case
 
EXT_JNJ_SECURITY_OAUTH2ISSUERURI=https://sit.medtech.accounts.jnj/oauth2/aus617lxuwiIglIrr4h7
EXT_JNJ_SECURITY_JWTSECRET=671491AE98362741F722202EED3288E8FF2508B35315ADBF75EEB3195A926B40
