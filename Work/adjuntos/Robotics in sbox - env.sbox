EXT_JNJ_WEBCLIENT_TOKENURI=https://sit.medtech.accounts.jnj/oauth2/aus617lxuwiIglIrr4h7/v1/token
 
 
# Force Mock Services
# EXT_JNJ_ENABLEDMOCKSERVICES=kafka
KAFKA_LOCAL=true
 
# Enable local feature toggle
EXT_JNJ_FEATURE_TOGGLE_LOCAL=true
EXT_JNJ_AUTH_SILENTMODE=true